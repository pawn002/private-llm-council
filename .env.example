# The Sovereign Council - Environment Configuration
# Copy to .env and adjust as needed

# Port for the frontend (default: 3000)
COUNCIL_PORT=3000

# Ollama host (default: host.docker.internal for Docker Desktop)
# For Linux without Docker Desktop, use your host IP or:
#   - host-gateway: OLLAMA_HOST=http://host-gateway:11434
#   - bridge network: OLLAMA_HOST=http://172.17.0.1:11434
OLLAMA_HOST=http://host.docker.internal:11434

# Privacy mode (SOVEREIGN, SANCTUARY, or CITADEL)
# SOVEREIGN: Maximum privacy, network check enabled
# SANCTUARY: Local-only mode (default)
# CITADEL: Containerized mode
PRIVACY_MODE=SANCTUARY
